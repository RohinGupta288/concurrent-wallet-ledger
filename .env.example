# Copy this file to .env and adjust the values.  (PowerShell:  Copy-Item .env.example .env)
# .env is git-ignored. Never commit real secrets.

# development | test | production
NODE_ENV=development

# HTTP port for the API
PORT=3000

# MongoDB connection string. MUST point at a replica set (note ?replicaSet=rs0),
# because money transfers use multi-document transactions.
MONGO_URI=mongodb://127.0.0.1:27017/backend-ledger?replicaSet=rs0

# Secret used to sign JWTs. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-characters

# How long a login token stays valid (jsonwebtoken format: 15m, 1h, 1d ...)
JWT_EXPIRES_IN=1d

# bcrypt cost factor for password hashing (10 is a good default; tests use 4 for speed)
BCRYPT_SALT_ROUNDS=10

# debug | info | warn | error | silent
LOG_LEVEL=info

# Maximum attempts for one MongoDB transaction when it hits a transient
# write conflict (bounded retry, see src/config/transaction.js)
TXN_MAX_ATTEMPTS=10

# Optional: run the test suite against an existing replica set instead of the
# automatically started in-memory one. The database name MUST contain "test",
# because tests delete all data in it.
# TEST_MONGO_URI=mongodb://127.0.0.1:27017/backend-ledger-test?replicaSet=rs0

# Optional: port used by `npm run db:dev`
# DEV_DB_PORT=27017
