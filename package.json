{
  "name": "backend-ledger",
  "version": "1.0.0",
  "description": "Educational concurrent-safe digital wallet with a double-entry ledger (simulated INR, Node.js + Express + MongoDB).",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:dev": "node scripts/dev-db.js",
    "seed": "node scripts/seed.js",
    "fund": "node scripts/fund-wallet.js",
    "wallet:status": "node scripts/set-wallet-status.js",
    "reconcile": "node scripts/reconcile.js",
    "test": "jest --runInBand"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.5"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.32"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/tests/globalSetup.js",
    "globalTeardown": "<rootDir>/tests/globalTeardown.js",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "testTimeout": 30000
  },
  "devDependencies": {
    "autocannon": "^9.0.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.4.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  }
}
